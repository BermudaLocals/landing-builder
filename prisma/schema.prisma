generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects Project[]
  aiUsages AiUsage[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  slug        String   @unique
  description String?
  components  Json     // Array of component data
  styles      Json?    // Global styles
  seo         Json?    // SEO settings
  published   Boolean  @default(false)
  publishedUrl String?
  publishedAt DateTime?
  publishedHtml String?  // Full HTML snapshot served at /p/[slug]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])
  aiUsages AiUsage[]

  @@index([userId])
  @@index([slug])
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  projectId        String?
  provider         String
  model            String
  success          Boolean
  prompt           String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  costUsd          Float?
  error            String?
  createdAt        DateTime @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([projectId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  preview     String?  // Preview image URL
  components  Json     // Template components
  styles      Json?    // Template styles
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
}
