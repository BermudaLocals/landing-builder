# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/launchpad

# Deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Generation (Phase 3A)
# Provider selection (server-side only): kimi | nvidia | openai | mock
# mock = deterministic offline provider (default, no key needed)
AI_PROVIDER=mock

# Kimi (Moonshot) — required when AI_PROVIDER=kimi
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
# KIMI_BASE_URL=https://api.moonshot.ai/v1

# NVIDIA NIM — required when AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenAI (optional provider) — required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Vercel Deployment
VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_project_id
VERCEL_ORG_ID=your_org_id
